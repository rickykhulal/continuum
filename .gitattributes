# The repository normalizes to LF in the blobs, so a Linux clone (CI, Render) and a Windows working
# copy run the same scripts. Without this, core.autocrlf=true on the dev machine and =false on the
# host disagree, and a CRLF shebang in scripts/*.mjs is an "exec format error" in CI.
* text=auto eol=lf

# Byte-exact assets: a text filter here would corrupt the globe textures the manifest hashes.
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

# Everything named by public/data/bundle_manifest.json is hashed byte-for-byte, so the bytes that
# leave this repository have to be the bytes that arrive. Measured on 2026-11-03: `text=auto`
# normalised public/tle/satellites.txt from 845 CRLF bytes to 830 LF bytes, a fresh clone's copy no
# longer matched its manifest entry, and GET /ready answered 503 — "tle/satellites.txt: checksum
# mismatch" — which is exactly the fail-closed behaviour doing its job. `-text` opts the hashed set
# out of every conversion, whatever the local core.autocrlf says.
public/data/** -text
public/tle/** -text
public/textures/** -text
